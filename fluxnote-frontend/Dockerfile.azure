# Build stage
FROM node:20-alpine AS build
WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci

# Copy source code and build
COPY . .
RUN npm run build

# Production stage with nginx
FROM nginx:alpine AS runtime

# Copy built app to nginx
COPY --from=build /app/dist/fluxnote-frontend/browser /usr/share/nginx/html

# Copy Azure-specific nginx configuration (proxies /api to Azure backend App Service)
COPY nginx.azure.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

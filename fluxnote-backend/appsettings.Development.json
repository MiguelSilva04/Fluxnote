{
  "Authentication": {
    "ExternalCallbackUrl": "http://localhost:4200/auth/external-callback",
    "ExternalErrorUrl": "http://localhost:4200/auth/external-error"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AspNetCoreRateLimit": "Debug",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authentication.Google": "Debug",
      "Microsoft.AspNetCore.Authentication.MicrosoftAccount": "Debug"
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "GeneralRules": [
      {
        "Endpoint": "post:/api/auth/refresh",
        "Period": "1m",
        "Limit": 1000
      },
      {
        "Endpoint": "post:/api/auth/register",
        "Period": "1h",
        "Limit": 1000
      },
      {
        "Endpoint": "post:/api/auth/login",
        "Period": "15m",
        "Limit": 10000
      },
      {
        "Endpoint": "get:/api/auth/external-login/*",
        "Period": "5m",
        "Limit": 1000
      }
    ]
  }
}
